{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "order-app": {
      "type": "application",
      "root": "apps/order-app",
      "entryFile": "order.main",
      "sourceRoot": "apps/order-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order-app/tsconfig.app.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "telegram-bot": {
      "type": "application",
      "root": "apps/telegram-bot",
      "entryFile": "telegram.main",
      "sourceRoot": "apps/telegram-bot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telegram-bot/tsconfig.app.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "user-app": {
      "type": "application",
      "root": "apps/user-app",
      "entryFile": "user.main",
      "sourceRoot": "apps/user-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-app/tsconfig.app.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    }
  }
}
